# Perk Loop env — copy to .env and fill. Never commit .env
PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/perkloop.db
SESSION_SECRET=change-me-32-chars-min
# Email OTP (MVP dev prints to console; prod needs SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Perk Loop <no-reply@perploop.in>"
# SMS OTP — Twilio Verify. If empty, API returns honest 503 setup-required
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Google Maps (browser key must be origin-restricted)
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
# QR / txn
TXN_QR_TTL_SEC=300
OTP_TTL_SEC=600
APP_BASE_URL=http://localhost:3001
